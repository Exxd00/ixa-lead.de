# Google-Apps-Script-Web-App für Formular-Anfragen und freigegebene Conversion-Ereignisse.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# E-Mail-Benachrichtigung nach erfolgreichem Speichern in Google Sheets.
RESEND_API_KEY=
RESEND_FROM_EMAIL="IXA Leads <leads@notify.ixa-leads.de>"
LEAD_NOTIFICATION_EMAIL=info@ixa-leads.de

# Google Analytics 4. Wird erst nach ausdrücklicher Statistik-Einwilligung geladen.
NEXT_PUBLIC_GA4_ID=

# Private owner hub. Never expose these as NEXT_PUBLIC variables.
# Format: <hex-salt>:<scrypt-hash>. The plain password never belongs here.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_GOOGLE_SHEET_URL=
ADMIN_GA4_URL=
ADMIN_APPS_SCRIPT_URL=
