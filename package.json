{
  "name": "ixa-leads",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "test:outreach": "node scripts/verify-whatsapp-contract.cjs",
    "test:page-activation": "python3 -m unittest scripts.tests.test_personal_page_batch -v",
    "test:postal-activation": "python3 -m unittest scripts.tests.test_postal_activation -v",
    "test:postal-v5": "python3 -m unittest scripts.tests.test_create_postal_batch -v",
    "test:ixa": "npm run test:outreach && npm run test:page-activation && npm run test:postal-activation && npm run test:postal-v5",
    "test:whatsapp": "node scripts/verify-whatsapp-contract.cjs",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
